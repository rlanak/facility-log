# Copy to .env (next to run.py, next to FacilityLog.exe, or for docker compose)
# to turn on web mode with Discord login. Without DISCORD_CLIENT_ID the app runs
# in local mode: no login, exactly as before. See CLAUDE.md, "Modo web".

# Discord Developer Portal -> your application -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must be registered under OAuth2 -> Redirects, exactly like this:
DISCORD_REDIRECT_URI=https://your-domain.example/auth/callback

# Discord: Settings -> Advanced -> Developer Mode, then right-click to "Copy ID"
DISCORD_GUILD_ID=
# One or more role IDs, comma-separated — anyone with any of them gets in
DISCORD_ALLOWED_ROLE_IDS=

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional: interface/port uvicorn listens on (python run.py / the .exe).
# HOST=127.0.0.1
# PORT=8000
