# Copy to .env (next to run.py, or next to docker-compose.yml)
# to turn on web mode with Discord login. Without DISCORD_CLIENT_ID the app runs
# in local mode: no login. See README.md, "Rodar na web".

# Discord Developer Portal -> your application -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must be registered under OAuth2 -> Redirects, exactly like this:
DISCORD_REDIRECT_URI=https://your-domain.example/auth/callback

# Discord: Settings -> Advanced -> Developer Mode, then right-click to "Copy ID"
DISCORD_GUILD_ID=
# One or more role IDs, comma-separated — anyone with any of them gets in
DISCORD_ALLOWED_ROLE_IDS=

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Recommended on a server: key that encrypts the secrets kept in the database
# (Discord webhook URLs, capture API key). Keep it out of the
# data volume/backups. Without it a key file is created at data/secret.key.
# Generate with the same command as SESSION_SECRET. Don't change it later
# (old values would stop decrypting) — add it before the first real use.
FACILITY_LOG_SECRET_KEY=

# Optional: interface/port uvicorn listens on (python run.py).
# HOST=127.0.0.1
# PORT=8000

# Optional: delete uploaded screenshots older than this many days. They are
# only used while being read (nothing shows them again), and kept forever they
# grow the data folder and every backup of it. Unset or 0 = keep them all.
# FACILITY_LOG_UPLOAD_DAYS=30

# Optional: this server has its own Ollama (a GPU machine) and should offer
# "IA local" to everyone. Off by default on the web, where each person can
# instead use the AI on their own computer from the browser (Configurações).
# FACILITY_LOG_SERVER_OLLAMA=1
